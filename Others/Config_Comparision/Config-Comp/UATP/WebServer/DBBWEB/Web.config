<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="http://schemas.microsoft.com/.NetConfiguration/v2.0">
	<configSections>
		<section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" />
	</configSections>
	<nlog throwExceptions="true" internalLogFile="D:\LOGs\DBBWEBHandlerLogs\nlog.txt" internalLogLevel="Fatal">
		<extensions>
			<add assembly="dbbHandler2005" />
		</extensions>
		<targets>
			<target type="File" name="general" layout="${longdate} - ${threadid} - ${logger} - ${message}" archiveAboveSize="200000000" maxArchiveFiles="10" archiveNumbering="Sequence" archiveEvery="Day" fileName="D:\LOGs\DBBWEBHandlerLogs\dbbHandler.log" archiveFileName="D:\LOGs\DBBWEBHandlerLogs\dbbHandler-${shortdate}-${time}.log" concurrentWrites="True" keepFileOpen="True" />
			<target name="syslog" type="Syslog" syslogserver="linux001" port="514" facility="Audit" />
		</targets>
		<rules>
			<logger name="Error" minlevel="Debug" writeTo="general" final="True" />
			<logger name="Debug" minlevel="Debug" writeTo="general" final="True" />
			<!--<logger name="Warning" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="Info" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="RequestDebug" minlevel="Debug" writeTo="general" final="True" />-->
			<!--<logger name="ThrottleDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="ScaleDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<logger name="UnsafeDebug" minlevel="Debug" writeTo="general" final="True" />
			<!--<logger name="SingleSignonDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="CryptDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="HeaderDebug" minlevel="Debug" writeTo="general" final="True" />-->
			<!--<logger name="KeywordDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="AuthDebug" minlevel="Debug" writeTo="general" final="False" />-->
			<logger name="ServiceResponse" minlevel="Debug" writeTo="general" final="True" />
			<!--<logger name="ReverseIpLookup" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="XmlServiceInput" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="XmlServiceOutput" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="LocalIpMasks" minlevel="Debug" writeTo="general" final="False" />-->
			<!--<logger name="Profiling" minlevel="Debug" writeTo="general" final="True" />-->
		</rules>
	</nlog>
	<appSettings>
		<add key="ImagePath" value="/dbbImages" />
		<add key="ServerIP" value="patuat-us-east-1-blue.multi-svc.infra.marcus.com" />
		<add key="LogoutPage" value="/" />
		<add key="ErrorPage" value="/dbbErrorPage.htm" />
		<add key="OutOfMemoryPage" value="/dbbErrorPage.htm" />
		<add key="UncaughtExceptionPage" value="/dbbErrorPage.htm" />
		<add key="NotLoggedInPage" value="/dbbNotLogin.htm" />
		<add key="SessionTimeoutPage" value="/dbbTimeout.htm" />
		<add key="LoginFailurePage" value="/dbbloginFailurePage.htm" />
		<add key="SecurityMismatchPage" value="/dbbBadSecurityPage.htm" />
		<add key="RequestTimeoutPage" value="/dbbTimeout.htm" />
		<add key="accountlockedpage" value="/dbbaccountlocked.htm" />
	</appSettings>
