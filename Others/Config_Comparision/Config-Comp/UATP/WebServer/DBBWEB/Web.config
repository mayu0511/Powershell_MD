		<defaultDocument>
			<files>
				<add value="handlerindex.html" />
			</files>
		</defaultDocument>
		<validation validateIntegratedModeConfiguration="false" />
		<httpProtocol>
			<customHeaders>
				<add name="X-Frame-Options" value="SAMEORIGIN"/>
				<add name="X-XSS-Protection" value="1; mode=block"/>
				<add name="X-Content-Type-Options" value="nosniff"/>
				<add name="Access-Control-Allow-Origin" value="*"/>
				<add name="Strict-Transport-Security" value="max-age=31536000"/>
				<add name="Content-Security-Policy" value="default-src 'self';               
							style-src 'self' https://fonts.googleapis.com 'unsafe-inline';               
							script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.jquery.com https://ajax.googleapis.com;               
							font-src https://fonts.gstatic.com 'self';              
							img-src 'self' https://drccApps.corecard.com;
							report-uri /WebResource.axd?cspReport=true"/>
				<remove name="X-Powered-By" />
			</customHeaders>
		</httpProtocol>
		<directoryBrowse enabled="false" />
		<security>
			<requestFiltering removeServerHeader="true">
				<requestLimits maxAllowedContentLength="2147483648" maxUrl="2147483648" maxQueryString="2147483648" />
			</requestFiltering>
			<!--<authentication><windowsAuthentication enabled="true" /></authentication>-->
		</security>
		<rewrite>
			<rules>
				<rule name="app_offline" stopProcessing="true">
					<match url="dbbloginFailurePage.htm" />
					<action type="CustomResponse" statusCode="401" statusReason="Login Error" statusDescription="Login failed" />
				</rule>
				<rule name="app_AccountLocked" stopProcessing="true">
					<match url="dbbaccountlocked.htm" />
					<action type="CustomResponse" statusCode="403" statusReason="Locked" statusDescription="Account locked" />
				</rule>
			</rules>
		</rewrite>
		<httpErrors errorMode="Custom">
			<error statusCode="401" subStatusCode="" path="dbbLoginFailurePage.htm" responseMode="File" />
			<error statusCode="403" subStatusCode="" path="dbbaccountlocked.htm" responseMode="File" />
		</httpErrors>
	</system.webServer>
</configuration>
