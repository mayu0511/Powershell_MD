  <connectionStrings>
    <add name="CoreIssue" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_CoreIssue;Connect Timeout=120"/>
    <add name="CoreIssue_Main" connectionString="server=CCAPPLIST1;Integrated Security=SSPI;database=CCGS_CoreIssue;Connect Timeout=120"/>
    <add name="CoreLibrary" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_CoreLibrary;MultipleActiveResultSets=true;Connect Timeout=120"/>
    <add name="CoreSales" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_CoreIssue;Connect Timeout=120"/>
    <add name="CoreApp" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_CoreApp;Connect Timeout=120"/>
    <add name="CoreAuth" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_PCoreAuth;Connect Timeout=120"/>
    <add name="CoreCollect" connectionString="server=CCRPTLIST1;Integrated Security=SSPI;database=CCGS_RPT_CoreCollect;Connect Timeout=120"/>
  </connectionStrings>
  <applicationSettings>
