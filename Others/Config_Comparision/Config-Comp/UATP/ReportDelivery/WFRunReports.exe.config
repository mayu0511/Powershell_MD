    <add key="DFENV_AuthenticationMode_Main" value="WA"/>
    <add key="DFENV_UserID_Main" value="sa"/>
    <add key="DFENV_Password_Main" value=""/>
    <add key="User" value=""/>
    <add key="Password" value=""/>
    <add key="ReportsBase" value="D:\ReportDelivery\"/>
    <add key="ReportDSN" value="CCRPTLIST1" />
    <add key="CheckInterval" value="15"/>
