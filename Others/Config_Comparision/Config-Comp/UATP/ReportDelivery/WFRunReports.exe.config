    <add key="LogFolder" value="D:\ReportDelivery\Log"/>
    <add key="ErrorFolder" value="D:\ReportDelivery\Error"/>	
    <add key="maxconcurrency" value="50"/>
    <add key="BatchSize" value="1000"/>
    <add key="ProfileTimeLimit" value="0.5"/>	
    <add key="MultiInst" value="true"/>
    <add key="RenderXLSX" value="false"/>
