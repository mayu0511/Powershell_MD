<!--<log4net threshold="OFF">-->
<log4net>
<logger name="CoreSAMLLogger">
    <!--<level value="ALL"/>-->
    <appender-ref ref="CoreSAML"/>
  </logger>
  <appender name="CoreSAML" type="log4net.Appender.RollingFileAppender">
    <rollingStyle value="Composite" />
   <datePattern value="'_'MM_dd_yyyy"/>
    <preserveLogFileNameExtension value="true" />
    <file type="log4net.Util.PatternString" value="D:\Logs\CREDIT\CoreCredit\%property{log4net:HostName}_CoreSAML_%processid.log" />

    <appendToFile value="true" />
    <maxSizeRollBackups value="20" />
    <maximumFileSize value="50MB" />
    <!--maxSizeRollBackups is used for specify how many number of backup to keep-->

    <staticLogFileName value="false" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%level  %date [%thread] %logger user-%property{Log_UserId}  %message %exception%newline" />
    </layout>

    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="false" />
      <levelToMatch  value="INFO" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="FATAL" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="ERROR" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="DEBUG" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="WARN" />
    </filter>
  </appender>




  <!--<root>
    <level value="ALL" />
    <appender-ref ref="TraceAppender"/>
    <appender-ref ref="file" />  

  </root>-->
  <logger name="MainLogger">
    <!--<level value="ALL"/>-->
    <appender-ref ref="file"/>
    <appender-ref ref="TraceAppender"/>
    
  </logger>
  
  
  <appender name="TraceAppender" type="CC.CoreCredit.Common.LogUtility" >
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%level  %date [%thread] %logger user-%property{Log_UserId}  %message %exception%newline" />
    </layout>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="false" />
      <levelToMatch  value="INFO" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="FATAL" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="ERROR" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="DEBUG" />
    </filter>
<filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="WARN" />
    </filter>

  </appender>
  <!--Comment by shailab - Rolling File Appender is used for deciding the log file size if it is reached the file size than it will create a backup  -->
  <appender name="file" type="log4net.Appender.RollingFileAppender">
    <rollingStyle value="Composite" />
   <datePattern value="'_'MM_dd_yyyy"/>
    <preserveLogFileNameExtension value="true" />
    <!--Comment by shailab - We need to change this file path in every machine  -->
    <file type="log4net.Util.PatternString" value="D:\LOGs\CREDIT\CoreCreditLogs\%property{log4net:HostName}_CoreCredit_%processid.log" />
    <appendToFile value="true" />
    <maxSizeRollBackups value="20" />
    <maximumFileSize value="50MB" />
    <!--maxSizeRollBackups is used for specify how many number of backup to keep-->
    
    <staticLogFileName value="false" />
    <layout type="log4net.Layout.PatternLayout">
      <footer value="&#13;&#10;" />
      <conversionPattern value="%level  %date [%thread] %logger user-%property{Log_UserId}  %message %exception%newline" />
    </layout>
    
    
    <!--Filter value false means this that  will never print in log -->
    
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="false" />
      <levelToMatch  value="INFO" />
    </filter>
     <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="FATAL" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="ERROR" />
    </filter>
    <filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="DEBUG" />
    </filter>
<filter type="log4net.Filter.LevelMatchFilter">
      <acceptOnMatch value="true" />
      <levelToMatch  value="WARN" />
    </filter>

  </appender>
  
</log4net>