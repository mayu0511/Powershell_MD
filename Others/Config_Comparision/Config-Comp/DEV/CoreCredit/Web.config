    <!--KafkaLog URL and Title-->
    <add key="KafkaLogURL" value="http://10.206.1.121:9092" />
    <add key="KafkaLogTitle" value="TestWebAPIKafka" />
    <!--LoggingMethod 1 for Log4Net and 2 for Kafka-->
    <add key="LoggingMethod" value="1" />
    <add key="GetLutFrmJson" value="0" />
    <add key="LutJsonFilePathSet1" value="D:\WebServer\CoreCredit\XMLFiles\LUTJsonFile_Set1.json" />
    <add key="LutJsonFilePathSet2" value="D:\WebServer\CoreCredit\XMLFiles\LUTJsonFile_Set2.json" />
